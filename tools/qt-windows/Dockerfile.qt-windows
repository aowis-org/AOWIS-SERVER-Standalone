# Debian 13 stable + Qt 6.12 Windows binaries and matching GCC 15.1 toolchain.
# Qt and its matching compiler are installed together; no upstream sources are patched.
FROM debian:13-slim

ARG AOWIS_QT_VERSION=6.12.0
ARG AOWIS_MINGW_VERSION=15.1.0
# The last aqtinstall release (3.3.0) cannot read Qt 6.11+ Windows package paths.
# Pin upstream's merged fix for https://github.com/miurahr/aqtinstall/pull/1000 .
# Update to a released aqtinstall when the fix is published.
ARG AOWIS_AQT_GIT_REF=8c3695d
ARG AOWIS_ZLIB_VERSION=1.3.2
ARG AOWIS_TIFF_VERSION=4.7.2
ARG AOWIS_WINDOWS_DEPS_PREFIX=C:/aowis-deps

ENV DEBIAN_FRONTEND=noninteractive \
    AOWIS_QT_VERSION=${AOWIS_QT_VERSION} \
    AOWIS_MINGW_VERSION=${AOWIS_MINGW_VERSION} \
    WINEPREFIX=/home/user/.wine \
    WINEARCH=win64 \
    WINEDEBUG=-all \
    HOME=/home/user \
    PATH=/home/user/bin:/opt/aqt/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git bash python3 python3-venv \
    wine wine64 fonts-wine \
    cmake ninja-build zip unzip 7zip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/aqt \
    && /opt/aqt/bin/pip install --no-cache-dir "git+https://github.com/miurahr/aqtinstall.git@${AOWIS_AQT_GIT_REF}" \
    && useradd --create-home --shell /bin/bash user \
    && mkdir -p /home/user/bin \
    && chown -R user:user /home/user

COPY --chown=user:user setup_toolchain.sh /home/user/setup_toolchain.sh
USER user
WORKDIR /home/user

# Fail immediately if the Qt and GCC ABI do not match or a simple C++20
# program fails to compile with the Windows compiler and Qt's own libraries.
RUN bash /home/user/setup_toolchain.sh \
    && rm -f /home/user/setup_toolchain.sh

# Preserve the existing pinned, native Windows zlib and libtiff builds.
# Those DLLs are bundled with the GUI by build_windows_inside_container.sh.
RUN set -eux; \
    git clone --depth 1 --branch "v${AOWIS_ZLIB_VERSION}" https://github.com/madler/zlib.git /home/user/aowis-zlib; \
    cd /home/user/aowis-zlib; \
    test "$(git rev-parse HEAD)" = "da607da739fa6047df13e66a2af6b8bec7c2a498"; \
    qt-cmake . \
        -G Ninja \
        -B build-windows \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$AOWIS_WINDOWS_DEPS_PREFIX" \
        -DZLIB_BUILD_TESTING=OFF \
        -DZLIB_BUILD_SHARED=ON \
        -DZLIB_BUILD_STATIC=OFF; \
    cmake --build build-windows --parallel "$(nproc)"; \
    cmake --install build-windows; \
    cd /home/user; \
    rm -rf /home/user/aowis-zlib; \
    test -f "/home/user/.wine/drive_c/aowis-deps/include/zlib.h"; \
    find "/home/user/.wine/drive_c/aowis-deps/bin" -maxdepth 1 -type f -iname '*z*.dll' -print -quit | grep -q .

RUN set -eux; \
    git clone --depth 1 --branch "v${AOWIS_TIFF_VERSION}" https://gitlab.com/libtiff/libtiff.git /home/user/aowis-libtiff; \
    cd /home/user/aowis-libtiff; \
    test "$(git rev-parse HEAD)" = "d01a94be176f5f6a87f7ee1c0b32e65416aa2b4d"; \
    qt-cmake . \
        -G Ninja \
        -B build-windows \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$AOWIS_WINDOWS_DEPS_PREFIX" \
        -DCMAKE_PREFIX_PATH="$AOWIS_WINDOWS_DEPS_PREFIX" \
        -DBUILD_SHARED_LIBS=ON \
        -Dtiff-static=OFF \
        -Dtiff-tools=OFF \
        -Dtiff-tests=OFF \
        -Dtiff-contrib=OFF \
        -Dtiff-docs=OFF \
        -Dtiff-cxx=OFF \
        -Dtiff-opengl=OFF \
        -Dzlib=ON \
        -Dlibdeflate=OFF \
        -Djpeg=OFF \
        -Djbig=OFF \
        -Dlerc=OFF \
        -Dlzma=OFF \
        -Dzstd=OFF \
        -Dwebp=OFF; \
    cmake --build build-windows --parallel "$(nproc)"; \
    cmake --install build-windows; \
    cd /home/user; \
    rm -rf /home/user/aowis-libtiff; \
    test -f "/home/user/.wine/drive_c/aowis-deps/include/tiff.h"; \
    test -f "/home/user/.wine/drive_c/aowis-deps/include/tiffio.h"; \
    find "/home/user/.wine/drive_c/aowis-deps/lib" -maxdepth 1 -type f \( -iname '*tiff*.a' -o -iname '*tiff*.lib' \) -print -quit | grep -q .; \
    find "/home/user/.wine/drive_c/aowis-deps/bin" -maxdepth 1 -type f -iname '*tiff*.dll' -print -quit | grep -q .
