# Debian 13 stable + Qt 6.12 Windows binaries and matching GCC 15.1 toolchain.
# Qt and its matching compiler are installed together; no upstream sources are patched.
FROM debian:13-slim

ARG AOWIS_QT_VERSION=6.12.0
ARG AOWIS_MINGW_VERSION=15.1.0
# The last aqtinstall release (3.3.0) cannot read Qt 6.11+ Windows package paths.
# Pin upstream's merged fix for https://github.com/miurahr/aqtinstall/pull/1000 .
# Update to a released aqtinstall when the fix is published.
ARG AOWIS_AQT_GIT_REF=8c3695d
ARG AOWIS_ZLIB_VERSION=1.3.2
ARG AOWIS_TIFF_VERSION=4.7.2
ARG AOWIS_PNG_VERSION=1.6.50
ARG AOWIS_WINDOWS_DEPS_PREFIX=C:/aowis-deps

ENV DEBIAN_FRONTEND=noninteractive \
    AOWIS_QT_VERSION=${AOWIS_QT_VERSION} \
    AOWIS_MINGW_VERSION=${AOWIS_MINGW_VERSION} \
    WINEPREFIX=/home/user/.wine \
    WINEARCH=win64 \
    WINEDEBUG=-all \
    HOME=/home/user \
    PATH=/home/user/bin:/opt/aqt/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git bash python3 python3-venv \
    wine wine64 fonts-wine \
    cmake ninja-build zip unzip 7zip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/aqt \
    && /opt/aqt/bin/pip install --no-cache-dir "git+https://github.com/miurahr/aqtinstall.git@${AOWIS_AQT_GIT_REF}" \
    && useradd --create-home --shell /bin/bash user \
    && mkdir -p /home/user/bin \
    && chown -R user:user /home/user

COPY --chown=user:user setup_toolchain.sh /home/user/setup_toolchain.sh
USER user
WORKDIR /home/user

# Fail immediately if the Qt and GCC ABI do not match or a simple C++20
# program fails to compile with the Windows compiler and Qt's own libraries.
RUN bash /home/user/setup_toolchain.sh \
    && rm -f /home/user/setup_toolchain.sh

# Preserve the existing pinned, native Windows zlib and libtiff builds.
# Those DLLs are bundled with the GUI by build_windows_inside_container.sh.
RUN set -eux; \
    git clone --depth 1 --branch "v${AOWIS_ZLIB_VERSION}" https://github.com/madler/zlib.git /home/user/aowis-zlib; \
    cd /home/user/aowis-zlib; \
    test "$(git rev-parse HEAD)" = "da607da739fa6047df13e66a2af6b8bec7c2a498"; \
    qt-cmake . \
        -G Ninja \
        -B build-windows \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$AOWIS_WINDOWS_DEPS_PREFIX" \
        -DZLIB_BUILD_TESTING=OFF \
        -DZLIB_BUILD_SHARED=ON \
        -DZLIB_BUILD_STATIC=OFF; \
    cmake --build build-windows --parallel "$(nproc)"; \
    cmake --install build-windows; \
    cd /home/user; \
    rm -rf /home/user/aowis-zlib; \
    test -f "/home/user/.wine/drive_c/aowis-deps/include/zlib.h"; \
    find "/home/user/.wine/drive_c/aowis-deps/bin" -maxdepth 1 -type f -iname '*z*.dll' -print -quit | grep -q .

RUN set -eux; \
    git clone --depth 1 --branch "v${AOWIS_TIFF_VERSION}" https://gitlab.com/libtiff/libtiff.git /home/user/aowis-libtiff; \
    cd /home/user/aowis-libtiff; \
    test "$(git rev-parse HEAD)" = "d01a94be176f5f6a87f7ee1c0b32e65416aa2b4d"; \
    qt-cmake . \
        -G Ninja \
        -B build-windows \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$AOWIS_WINDOWS_DEPS_PREFIX" \
        -DCMAKE_PREFIX_PATH="$AOWIS_WINDOWS_DEPS_PREFIX" \
        -DBUILD_SHARED_LIBS=ON \
        -Dtiff-static=OFF \
        -Dtiff-tools=OFF \
        -Dtiff-tests=OFF \
        -Dtiff-contrib=OFF \
        -Dtiff-docs=OFF \
        -Dtiff-cxx=OFF \
        -Dtiff-opengl=OFF \
        -Dzlib=ON \
        -Dlibdeflate=OFF \
        -Djpeg=OFF \
        -Djbig=OFF \
        -Dlerc=OFF \
        -Dlzma=OFF \
        -Dzstd=OFF \
        -Dwebp=OFF; \
    cmake --build build-windows --parallel "$(nproc)"; \
    cmake --install build-windows; \
    cd /home/user; \
    rm -rf /home/user/aowis-libtiff; \
    test -f "/home/user/.wine/drive_c/aowis-deps/include/tiff.h"; \
    test -f "/home/user/.wine/drive_c/aowis-deps/include/tiffio.h"; \
    find "/home/user/.wine/drive_c/aowis-deps/lib" -maxdepth 1 -type f \( -iname '*tiff*.a' -o -iname '*tiff*.lib' \) -print -quit | grep -q .; \
    find "/home/user/.wine/drive_c/aowis-deps/bin" -maxdepth 1 -type f -iname '*tiff*.dll' -print -quit | grep -q .

# libpng for AOWIS-SERVER-MAP (find_package(PNG)), against the zlib above.
# Shared like zlib/libtiff; its DLL ships with the GUI via C:/aowis-deps/bin.
RUN set -eux; \
    git clone --depth 1 --branch "v${AOWIS_PNG_VERSION}" https://github.com/pnggroup/libpng.git /home/user/aowis-libpng; \
    cd /home/user/aowis-libpng; \
    echo "libpng v${AOWIS_PNG_VERSION} at $(git rev-parse HEAD)"; \
    qt-cmake . \
        -G Ninja \
        -B build-windows \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$AOWIS_WINDOWS_DEPS_PREFIX" \
        -DCMAKE_PREFIX_PATH="$AOWIS_WINDOWS_DEPS_PREFIX" \
        -DPNG_SHARED=ON \
        -DPNG_STATIC=OFF \
        -DPNG_TESTS=OFF \
        -DPNG_TOOLS=OFF; \
    cmake --build build-windows --parallel "$(nproc)"; \
    cmake --install build-windows; \
    cd /home/user; \
    rm -rf /home/user/aowis-libpng; \
    test -f "/home/user/.wine/drive_c/aowis-deps/include/png.h"; \
    find "/home/user/.wine/drive_c/aowis-deps/lib" -maxdepth 1 -type f -iname '*png*.a' -print -quit | grep -q .; \
    find "/home/user/.wine/drive_c/aowis-deps/bin" -maxdepth 1 -type f -iname '*png*.dll' -print -quit | grep -q .

# Embedded WireGuard engine (AOWIS-NETWORK): Linux Go cross-builds it as a C
# archive; its few cgo stubs are compiled by the MinGW-w64 cross compiler
# (plain C ABI, MSVCRT and POSIX threads like Qt's GCC 15.1 MinGW). Running
# Go itself under Wine is avoided. Appended last so Qt layers stay cached.
ARG AOWIS_GO_VERSION=1.27.3
USER root
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64-posix; \
    rm -rf /var/lib/apt/lists/*; \
    archive="go${AOWIS_GO_VERSION}.linux-amd64.tar.gz"; \
    curl --fail --location --retry 4 --retry-delay 5 --silent --show-error \
        -o "/tmp/$archive" "https://dl.google.com/go/$archive"; \
    curl --fail --location --retry 4 --retry-delay 5 --silent --show-error \
        -o "/tmp/$archive.sha256" "https://dl.google.com/go/$archive.sha256"; \
    echo "$(tr -d ' \n' < "/tmp/$archive.sha256")  /tmp/$archive" | sha256sum -c -; \
    tar -C /usr/local -xzf "/tmp/$archive"; \
    rm -f "/tmp/$archive" "/tmp/$archive.sha256"; \
    mkdir -p /home/user/.cache/aowis-go; \
    chown -R user:user /home/user/.cache
# Module and build caches live in one directory that compile_windows.sh mounts
# as a named volume, so dependencies are downloaded once, not per build.
ENV PATH=/usr/local/go/bin:${PATH} \
    GOTOOLCHAIN=local \
    GOPATH=/home/user/.cache/aowis-go/path \
    GOMODCACHE=/home/user/.cache/aowis-go/mod \
    GOCACHE=/home/user/.cache/aowis-go/build
USER user
# Fail now if the cross compiler targets UCRT: its objects would not link
# against Qt's MSVCRT runtime.
RUN set -eux; \
    go version; \
    printf '#include <stdio.h>\n#ifdef _UCRT\n#error UCRT runtime\n#endif\nint main(void){return puts("ok");}\n' > /tmp/crt.c; \
    x86_64-w64-mingw32-gcc-posix -c /tmp/crt.c -o /tmp/crt.o; \
    rm -f /tmp/crt.c /tmp/crt.o
